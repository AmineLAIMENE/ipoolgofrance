# Variables à créer dans Netlify : Site configuration > Environment variables.
# Ne mettez jamais de vraie clé dans ce fichier ni dans le dépôt.

# Clé secrète Stripe : clé restreinte rk_... (ou sk_...). rk_test_ pour essayer, rk_live_ en production.
# Droits nécessaires : Checkout Sessions (écriture), PaymentIntents (écriture), Charges (lecture).
STRIPE_SECRET_KEY=

# Secret de signature du webhook Stripe (whsec_...), donné à la création du webhook.
STRIPE_WEBHOOK_SECRET=

# Clé API Brevo (e-mails transactionnels).
BREVO_API_KEY=

# Facultatif : adresse qui reçoit l'alerte « Nouvelle commande payée »
# (par défaut contact@gigifrance.fr, voir netlify/lib/notify.js).
# SELLER_EMAIL=

# Facultatif : adresse d'expédition des e-mails, validée dans Brevo
# (par défaut contact@gigifrance.fr).
# SENDER_EMAIL=

# Facultatif : autre adresse du site pour un essai (par défaut https://ipoolgofrance.fr).
# SITE_URL=
